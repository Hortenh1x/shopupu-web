# Base URL of the shopupu backend API.
# Local dev uses http://localhost:8080; in production this MUST be https:// so the
# access/refresh tokens are never sent in cleartext.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Deep-link scheme used to hand a payment off to a bank app (optional).
NEXT_PUBLIC_BANK_APP_PROTOCOL=bankfront://

# "Sign in with Google" OAuth 2.0 Web Client ID (from Google Cloud Console).
# Must match the backend's GOOGLE_CLIENT_ID. Leave blank to hide the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
